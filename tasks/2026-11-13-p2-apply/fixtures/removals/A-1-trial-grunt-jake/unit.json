{
  "id": "A-1-trial-grunt-jake",
  "stage": "A",
  "order": 101,
  "enabled": true,
  "intent": "試し用（apply.mjs の確かめ）。組み込み拡張 grunt と jake を消し、一覧の行を removeLines で消す",
  "after": [],
  "delete": [
    "extensions/grunt",
    "extensions/jake",
    "extensions/no-such-extension"
  ],
  "removeDependencies": {},
  "removeLines": [
    { "file": "build/npm/dirs.ts", "line": "'extensions/grunt'," },
    { "file": "build/npm/dirs.ts", "line": "'extensions/jake'," },
    { "file": "build/gulpfile.extensions.ts", "line": "'extensions/grunt/tsconfig.json'," },
    { "file": "build/gulpfile.extensions.ts", "line": "'extensions/jake/tsconfig.json'," },
    { "file": "extensions/pnpm-workspace.yaml", "line": "- grunt" },
    { "file": "extensions/pnpm-workspace.yaml", "line": "- jake" }
  ],
  "productRemove": [],
  "kept": [],
  "checks": {
    "absentCommands": [],
    "absentViews": [],
    "absentSettings": [],
    "absentStrings": [
      { "in": ["build", "extensions/pnpm-workspace.yaml"], "text": "extensions/grunt" },
      { "in": ["build"], "text": "extensions/jake" }
    ],
    "absentProcesses": [],
    "absentHosts": []
  },
  "smoke": ["base"]
}
