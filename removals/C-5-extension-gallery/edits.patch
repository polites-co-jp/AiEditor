+
+	getAllRecommendationsWithReason(): IStringDictionary<IExtensionRecommendationReason> {
+		return {};
+	}
+
+	async getImportantRecommendations(): Promise<string[]> {
+		return [];
+	}
+
+	async getOtherRecommendations(): Promise<string[]> {
+		return [];
+	}
+
+	getFileBasedRecommendations(): string[] {
+		return [];
+	}
+
+	async getExeBasedRecommendations(exe?: string): Promise<{ important: string[]; others: string[] }> {
+		return { important: [], others: [] };
+	}
+
+	async getConfigBasedRecommendations(): Promise<{ important: string[]; others: string[] }> {
+		return { important: [], others: [] };
+	}
+
+	async getWorkspaceRecommendations(): Promise<Array<string | URI>> {
+		return [];
+	}
+
+	getKeymapRecommendations(): string[] {
+		return [];
+	}
+
+	getLanguageRecommendations(): string[] {
+		return [];
+	}
+
+	getRemoteRecommendations(): string[] {
+		return [];
+	}
+}
+
+export class NullExtensionIgnoredRecommendationsService implements IExtensionIgnoredRecommendationsService {
+
+	declare readonly _serviceBrand: undefined;
+
+	readonly onDidChangeIgnoredRecommendations = Event.None;
+	readonly ignoredRecommendations: string[] = [];
+
+	readonly onDidChangeGlobalIgnoredRecommendation: Event<IgnoredRecommendationChangeNotification> = Event.None;
+	readonly globalIgnoredRecommendations: string[] = [];
+
+	toggleGlobalIgnoredRecommendation(extensionId: string, ignore: boolean): void {
+		// there are no recommendations to ignore
+	}
+}
+
+export class NullExtensionRecommendationNotificationService implements IExtensionRecommendationNotificationService {
+
+	declare readonly _serviceBrand: undefined;
+
+	readonly ignoredRecommendations: string[] = [];
