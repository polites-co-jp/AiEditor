new file mode 100644
index 00000000000..be8017d15bc
--- /dev/null
+++ b/src/vs/workbench/api/common/extHostRemovedApi.debug.ts
@@ -0,0 +1,109 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import type * as vscode from 'vscode';
+import { Event } from '../../../base/common/event.js';
+import { URI } from '../../../base/common/uri.js';
+import { IExtensionDescription } from '../../../platform/extensions/common/extensions.js';
+import { checkProposedApiEnabled } from '../../services/extensions/common/extensions.js';
+
+/**
+ * Shuko (C-2-debug): the debugger (run and debug view, breakpoints, debug console, debug adapters)
+ * is removed. The extension API entry point `vscode.debug` stays, but does nothing:
+ * there is never an active session, registrations return a disposable that does nothing,
+ * `startDebugging` resolves to `false`, the debug console swallows its output and events never fire.
+ * Proposed API checks are kept so that the gating is the same as before.
+ */
+
+function noopDisposable(): vscode.Disposable {
+	return { dispose() { } };
+}
+
+const noopDebugConsole: vscode.DebugConsole = Object.freeze({
+	append(_value: string): void { },
+	appendLine(_value: string): void { },
+});
+
+/**
+ * Same as `ExtHostDebugServiceBase.asDebugSourceUri` of the removed `extHostDebugService.ts`
+ * (it does not need a debug session to exist).
+ */
+function asDebugSourceUri(src: vscode.DebugProtocolSource, session?: vscode.DebugSession): URI {
+	const source = src as { path?: string; sourceReference?: number };
+
+	if (typeof source.sourceReference === 'number' && source.sourceReference > 0) {
+		// src can be retrieved via DAP's "source" request
+
+		let debug = `debug:${encodeURIComponent(source.path || '')}`;
+		let sep = '?';
+
+		if (session) {
+			debug += `${sep}session=${encodeURIComponent(session.id)}`;
+			sep = '&';
+		}
+
+		debug += `${sep}ref=${source.sourceReference}`;
+
+		return URI.parse(debug);
+	} else if (source.path) {
+		// src is just a local file path
+		return URI.file(source.path);
+	} else {
+		throw new Error(`cannot create uri from DAP 'source' object; properties 'path' and 'sourceReference' are both missing.`);
+	}
+}
+
+export function createRemovedDebugApi(extension: IExtensionDescription): typeof vscode.debug {
+	return {
+		get activeDebugSession() {
+			return undefined;
+		},
+		get activeDebugConsole() {
+			return noopDebugConsole;
+		},
+		get breakpoints() {
+			return [];
+		},
+		get activeStackItem() {
+			return undefined;
+		},
+		registerDebugVisualizationProvider(_id, _provider) {
+			checkProposedApiEnabled(extension, 'debugVisualization');
+			return noopDisposable();
+		},
+		registerDebugVisualizationTreeProvider(_id, _provider) {
+			checkProposedApiEnabled(extension, 'debugVisualization');
+			return noopDisposable();
+		},
+		onDidStartDebugSession: Event.None,
+		onDidTerminateDebugSession: Event.None,
+		onDidChangeActiveDebugSession: Event.None,
+		onDidReceiveDebugSessionCustomEvent: Event.None,
+		onDidChangeBreakpoints: Event.None,
+		onDidChangeActiveStackItem: Event.None,
+		registerDebugConfigurationProvider(_debugType: string, _provider: vscode.DebugConfigurationProvider, _triggerKind?: vscode.DebugConfigurationProviderTriggerKind) {
+			return noopDisposable();
+		},
+		registerDebugAdapterDescriptorFactory(_debugType: string, _factory: vscode.DebugAdapterDescriptorFactory) {
+			return noopDisposable();
+		},
+		registerDebugAdapterTrackerFactory(_debugType: string, _factory: vscode.DebugAdapterTrackerFactory) {
+			return noopDisposable();
+		},
+		startDebugging(_folder: vscode.WorkspaceFolder | undefined, _nameOrConfig: string | vscode.DebugConfiguration, _parentSessionOrOptions?: vscode.DebugSession | vscode.DebugSessionOptions) {
+			return Promise.resolve(false);
+		},
+		stopDebugging(_session?: vscode.DebugSession) {
+			return Promise.resolve();
+		},
+		addBreakpoints(_breakpoints: readonly vscode.Breakpoint[]) {
+		},
+		removeBreakpoints(_breakpoints: readonly vscode.Breakpoint[]) {
+		},
+		asDebugSourceUri(source: vscode.DebugProtocolSource, session?: vscode.DebugSession): vscode.Uri {
+			return asDebugSourceUri(source, session);
+		}
+	};
+}
