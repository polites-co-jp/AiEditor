 .../browser/mainThreadTerminalService.test.ts |  2 --
 .../terminal/terminalContribExports.ts        |  7 ++---
 .../browser/terminalAccessibilityHelp.ts      | 11 -------
 .../terminal.initialHint.contribution.ts      |  9 +++---
 5 files changed, 7 insertions(+), 52 deletions(-)

