+import { NotebookControllerAffinity2 } from './extHostTypes.js';
+
+/**
+ * Sukuna (C-4-notebook): notebooks (the notebook editor, cell execution, kernels, output renderers),
+ * the interactive window and the notebook REPL are removed. The extension API entry points stay,
+ * but do nothing: there are never notebook documents or notebook editors, registrations return a
+ * disposable that does nothing, events never fire, and opening or showing a notebook is refused.
+ * Proposed API checks are kept so that the gating is the same as before.
+ */
+
+const notebooksUnavailable = 'Notebooks are not available in this build';
+
+function noopDisposable(): vscode.Disposable {
+	return { dispose() { } };
+}
+
+function createNoopNotebookController(extension: IExtensionDescription, id: string, notebookType: string, label: string, handler: ((cells: vscode.NotebookCell[], notebook: vscode.NotebookDocument, controller: vscode.NotebookController) => void | Thenable<void>) | undefined, rendererScripts: vscode.NotebookRendererScript[] | undefined): vscode.NotebookController {
+	let _executeHandler = handler ?? (() => { });
+	let _interruptHandler: ((notebook: vscode.NotebookDocument) => void | Thenable<void>) | undefined;
+	let _variableProvider: vscode.NotebookVariableProvider | undefined;
+	const _rendererScripts = rendererScripts ?? [];
+	return {
+		id,
+		notebookType,
+		label: label || extension.identifier.value,
+		description: '',
+		detail: '',
+		supportedLanguages: undefined,
+		supportsExecutionOrder: false,
+		get rendererScripts() {
+			return _rendererScripts;
+		},
+		get executeHandler() {
+			return _executeHandler;
+		},
+		set executeHandler(value) {
+			_executeHandler = value ?? (() => { });
+		},
+		get interruptHandler() {
+			return _interruptHandler;
+		},
+		set interruptHandler(value) {
+			_interruptHandler = value;
+		},
+		get variableProvider() {
+			return _variableProvider;
+		},
+		set variableProvider(value) {
+			checkProposedApiEnabled(extension, 'notebookVariableProvider');
+			_variableProvider = value;
+		},
+		onDidChangeSelectedNotebooks: Event.None,
+		onDidReceiveMessage: Event.None,
