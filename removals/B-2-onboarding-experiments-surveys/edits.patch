index 00000000000..4b7f0d9f4f0
--- /dev/null
+++ b/src/vs/workbench/services/assignment/common/noopAssignmentService.ts
@@ -0,0 +1,32 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { Event } from '../../../../base/common/event.js';
+import type { IAssignmentFilter, ITreatmentWithAssignment, IWorkbenchAssignmentService } from './assignmentService.js';
+
+/**
+ * Shuko (B-2-onboarding-experiments-surveys): experiments are removed. This implementation never creates
+ * the experiment client, never fetches assignments and never sends telemetry. Every treatment is unassigned,
+ * so each caller falls back to its default. Developer overrides (`experiments.override.<name>`) are not read.
+ */
+export class NoopWorkbenchAssignmentService implements IWorkbenchAssignmentService {
+	declare readonly _serviceBrand: undefined;
+
+	readonly onDidRefetchAssignments: Event<void> = Event.None;
+
+	async getCurrentExperiments(): Promise<string[] | undefined> {
+		return undefined;
+	}
+
+	async getTreatment<T extends string | number | boolean>(_name: string): Promise<T | undefined> {
+		return undefined;
+	}
+
+	async getTreatmentWithAssignment<T extends string | number | boolean>(_name: string): Promise<ITreatmentWithAssignment<T>> {
+		return { value: undefined, hasAssignment: Promise.resolve(false) };
+	}
+
+	addTelemetryAssignmentFilter(_filter: IAssignmentFilter): void { }
+}
