@@ -0,0 +1,348 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import type * as vscode from 'vscode';
+import { Event } from '../../../base/common/event.js';
+import { IExtensionDescription } from '../../../platform/extensions/common/extensions.js';
+import { checkProposedApiEnabled } from '../../services/extensions/common/extensions.js';
+import { ExtHostEmbeddings } from './extHostEmbedding.js';
+import { ChatInputNotificationSeverity } from './extHostTypes.js';
+
+/**
+ * Shuko (C-1-ai): the built-in AI (chat, inline chat, language models, language model tools, MCP,
+ * agent sessions) is removed. The extension API entry points `vscode.chat`, `vscode.lm` and the AI
+ * members of `vscode.window`, `vscode.workspace` and `vscode.interactive` stay, but do nothing:
+ * registrations return a disposable that does nothing, queries return nothing, events never fire.
+ * Proposed API checks are kept so that the gating is the same as before.
+ * The embeddings part of `vscode.lm` is not AI chat and still goes to {@link ExtHostEmbeddings}.
+ */
+
+const REMOVED = 'The built-in AI features are removed from this build';
+
+function noopDisposable(): vscode.Disposable {
+	return { dispose() { } };
+}
+
+function removedError(what: string): Error {
+	return new Error(`${what}: ${REMOVED}`);
+}
+
+function noopChatParticipant(id: string, handler: vscode.ChatExtendedRequestHandler): vscode.ChatParticipant {
+	return {
+		id,
+		iconPath: undefined,
+		requestHandler: handler,
+		followupProvider: undefined,
+		onDidReceiveFeedback: Event.None,
+		onDidChangePauseState: Event.None,
+		onDidPerformAction: Event.None,
+		dispose() { },
+	};
+}
+
+export function createRemovedChatApi(extension: IExtensionDescription): typeof vscode.chat {
+	return {
+		registerArtifactIntegrationProvider(_id: string, _provider: vscode.ChatArtifactIntegrationProvider) {
+			checkProposedApiEnabled(extension, 'chatArtifactIntegrations');
+			return noopDisposable();
+		},
+		registerMappedEditsProvider(_selector: vscode.DocumentSelector, _provider: vscode.MappedEditsProvider) {
+			checkProposedApiEnabled(extension, 'mappedEditsProvider');
+			return noopDisposable();
+		},
+		registerMappedEditsProvider2(_provider: vscode.MappedEditsProvider2) {
+			checkProposedApiEnabled(extension, 'mappedEditsProvider');
+			return noopDisposable();
+		},
+		createChatParticipant(id: string, handler: vscode.ChatExtendedRequestHandler) {
+			return noopChatParticipant(id, handler);
+		},
+		createDynamicChatParticipant(id: string, _dynamicProps: vscode.DynamicChatParticipantProps, handler: vscode.ChatExtendedRequestHandler): vscode.ChatParticipant {
