@@ -103,3 +104,20 @@ export interface IEditTelemetryCodeRejectedData extends IEditTelemetryBaseData {
 	/** User explicitly rejected/undid the suggestion (when presentation is `highlightedEdit`) or pressed Escape (when feature is `inlineSuggestion`) */
 	| 'reject';
 }
+
+// Shuko (B-1-telemetry): the rest of contrib/editTelemetry is removed. This file keeps the service id and
+// registers an implementation that records and sends nothing, for the parts that still inject the service
+// (the extension API in mainThreadLanguageFeatures, and chat until C-1).
+class NullAiEditTelemetryService implements IAiEditTelemetryService {
+	declare readonly _serviceBrand: undefined;
+
+	createSuggestionId(): EditSuggestionId {
+		return EditSuggestionId.newId();
+	}
+
+	handleCodeAccepted(): void { }
+
+	handleCodeRejected(): void { }
+}
+
+registerSingleton(IAiEditTelemetryService, NullAiEditTelemetryService, InstantiationType.Delayed);
