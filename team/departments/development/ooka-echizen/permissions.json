{
  "bash": [
    "git status",
    "git diff",
    "git log",
    "git show",
    "git rev-parse",
    "git ls-files",
    "git worktree list",
    "node --test tests/*.test.mjs",
    "node --test extensions-src/*/test/*.test.mjs",
    "node tests/*.mjs",
    "node scripts/apply.mjs",
    "node scripts/build.mjs",
    "node scripts/lock-verify.mjs",
    "pnpm --dir extensions-src/* run test",
    "pnpm --dir C:/b/wt/* run smoketest",
    "npx --prefix C:/b/wt/* tsc --noEmit",
    "powershell -NoProfile -ExecutionPolicy Bypass -File tests/*.ps1",
    "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/measure.ps1",
    "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/netaudit.ps1",
    "sha256sum",
    "git -C C:/b/wt/* status",
    "git -C C:/b/wt/* diff",
    "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/p1-ci-events.ps1 -OutFile tasks/*/*.json",
    "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-env.ps1 -OutFile tasks/*/*.json",
    "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/p1-launch-check.ps1 -OutFile tasks/*/*.json"
  ],
  "bash_exact": [
    "git -C C:/b/wt/* checkout *.*.*",
    "git -C C:/b/wt/* checkout -- pnpm-lock.yaml",
    "pnpm --dir C:/b/wt/* install --lockfile-only --ignore-scripts",
    "node scripts/disk-usage.mjs records=records"
  ],
  "write_paths": [
    "records/",
    "tasks/"
  ],
  "read_paths": [
    "./",
    "C:/b/"
  ],
  "secret_paths": [
    "%LOCALAPPDATA%/Shuko/watch/",
    "%LOCALAPPDATA%/Shuko/secrets/"
  ],
  "agents": [],
  "skills": [],
  "write_paths_deny": [
    "tasks/*/brief.md"
  ]
}
